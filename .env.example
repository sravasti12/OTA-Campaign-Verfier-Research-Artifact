# Choose one provider. No provider or model is silently substituted.
LLM_PROVIDER=ollama
# Required: an installed Ollama model or provider-supported model ID.
LLM_MODEL=
# Optional: a different model for the separate verification call.
LLM_VERIFIER_MODEL=
LLM_EXPLAINER_MODEL=
LLM_SCHEMA_MODE=schema
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=8192
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
