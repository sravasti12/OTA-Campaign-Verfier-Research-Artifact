      "default": "PROPOSED_UNREVIEWED",
      "title": "Review Status",
      "type": "string"
    },
    "project": {
      "title": "Project",
      "type": "string"
    },
    "url": {
      "title": "Url",
      "type": "string"
    },
    "revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revision"
    },
    "publication_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Date"
    },
    "retrieved_at": {
      "title": "Retrieved At",
      "type": "string"
    },
    "license_note": {
      "title": "License Note",
      "type": "string"
    },
    "source_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Path"
    },
    "source_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Sha256"
    },
    "excerpt": {
      "title": "Excerpt",
      "type": "string"
    },
    "excerpt_sha256": {
      "title": "Excerpt Sha256",
      "type": "string"
    },
    "source_start_char": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Start Char"
    },
    "source_end_char": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source End Char"
    },
    "context": {
      "title": "Context",
      "type": "string"
    },
    "classification": {
      "title": "Classification",
      "type": "string"
    },
    "proposed_constraints": {
      "items": {},
      "title": "Proposed Constraints",
      "type": "array"
    },
    "proposed_label_reason": {
      "title": "Proposed Label Reason",
      "type": "string"
    },
    "evidence_segments": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Evidence Segments",
      "type": "array"
    },
    "inventory_mapping": {
      "const": "UNRESOLVED_NOT_AN_EXECUTABLE_CASE",
      "default": "UNRESOLVED_NOT_AN_EXECUTABLE_CASE",
      "title": "Inventory Mapping",
      "type": "string"
    },
    "admission_blockers": {
      "items": {
        "type": "string"
      },
      "title": "Admission Blockers",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project",
    "url",
    "revision",
    "retrieved_at",
    "license_note",
    "source_path",
    "source_sha256",
    "excerpt",
    "excerpt_sha256",
    "source_start_char",
    "source_end_char",
    "context",
    "classification",
    "proposed_constraints",
    "proposed_label_reason",
    "evidence_segments",
    "admission_blockers"
  ],
