{
  "additionalProperties": false,
  "description": "Unreviewed excerpts are not executable cases until inventory/mapping and gold are approved.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "origin": {
      "const": "real_document",
